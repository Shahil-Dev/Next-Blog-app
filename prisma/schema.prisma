// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// User Roles Enum
enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

// Friend Request Status Enum
enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Multi-Reaction Enum
enum ReactionType {
  LOVE
  HAHA
  SAD
  ANGRY
}

// Comment Status Enum
enum CommentStatus {
  APPROVED
  FLAGGED
  REJECTED
}

